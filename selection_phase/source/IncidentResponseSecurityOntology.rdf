        <IncidentResponseSecurityOntology:hasStep rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Step_s13586"/>
        <IncidentResponseSecurityOntology:hasStep rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Step_s13587"/>
        <IncidentResponseSecurityOntology:providedBy rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Vendor_XSOAR"/>
        <IncidentResponseSecurityOntology:hasPlaybookDescription>This playbook is used for querying the PANW threat intelligence Autofocus system. The playbook accepts indicators such as IP&apos;s, hashes, domains to run basic queries or mode advanced queries that can leverage several query parameters. In order to run the more advanced queries its recommended to use the Autofocus UI https://autofocus.paloaltonetworks.com/#/dashboard/organization to created a query and than use the export search button. The result can be used as a playbook input.  The playbook supports searching both the Samples API and the sessions API.</IncidentResponseSecurityOntology:hasPlaybookDescription>
        <IncidentResponseSecurityOntology:hasPlaybookID>p1014</IncidentResponseSecurityOntology:hasPlaybookID>
        <IncidentResponseSecurityOntology:hasPlaybookName>Autofocus Query Samples, Sessions and Tags</IncidentResponseSecurityOntology:hasPlaybookName>
    </owl:NamedIndividual>
    


