        <IncidentResponseSecurityOntology:hasStep rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Step_s6723"/>
        <IncidentResponseSecurityOntology:hasStep rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Step_s6724"/>
