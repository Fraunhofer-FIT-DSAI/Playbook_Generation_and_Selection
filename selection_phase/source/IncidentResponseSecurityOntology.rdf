        <IncidentResponseSecurityOntology:hasPlaybookDescription>Periodically check Acknowledgement SLA violations of the Open Incidents.</IncidentResponseSecurityOntology:hasPlaybookDescription>
        <IncidentResponseSecurityOntology:hasPlaybookID>p113</IncidentResponseSecurityOntology:hasPlaybookID>
        <IncidentResponseSecurityOntology:hasPlaybookName>Incident - [04] Check for SLA violations</IncidentResponseSecurityOntology:hasPlaybookName>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Playbook_p1130 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Playbook_p1130">
        <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Playbook"/>
        <IncidentResponseSecurityOntology:hasStep rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Step_s15342"/>
        <IncidentResponseSecurityOntology:hasStep rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Step_s15343"/>
        <IncidentResponseSecurityOntology:hasStep rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Step_s15346"/>
