  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Playbook_p498">
    <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Playbook"/>
    <irso:hasPlaybookID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p498</irso:hasPlaybookID>
    <irso:hasPlaybookName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Delete Recently Disabled Assets in AD from InsightVM</irso:hasPlaybookName>
    <irso:hasPlaybookDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This workflow finds and optionally deletes assets in InsightVM that have been disabled in Active Directory. The workflow searches Active Directory for computer accounts that have been disabled in the previous 30 hours, looks up the DNS Hostname of each newly disabled asset, and searches for that hostname in InsightVM. If the user-defined parameter `Delete Assets from IVM?` is true, it then proceeds to delete the assets from InsightVM.</irso:hasPlaybookDescription>
    <irso:providedBy rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Vendor_Rapid7"/>
