    <irso:hasPlaybookName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TIM - Process Indicators - Fully Automated</irso:hasPlaybookName>
    <irso:hasPlaybookDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This playbook tags indicators ingested from high reliability feeds. The playbook is triggered due to a Cortex XSOAR job. The indicators are tagged as approved_white, approved_black, approved_watchlist. The tagged indicators will be ready for consumption for 3rd party systems such as SIEM, EDR etc.</irso:hasPlaybookDescription>
