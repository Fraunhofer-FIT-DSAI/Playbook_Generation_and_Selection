    <irso:hasPlaybookName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quarantine Endpoint with SentinelOne from Slack</irso:hasPlaybookName>
    <irso:hasPlaybookDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This workflow will quarantine and unquarantine an endpoint in SentinelOne from a Slack command. This workflow supports endpoints in the form of Agent IDs, hostnames, MAC addresses, or IP addresses.</irso:hasPlaybookDescription>
