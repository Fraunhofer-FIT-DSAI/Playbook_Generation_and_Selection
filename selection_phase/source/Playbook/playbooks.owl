  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Playbook_p454">
    <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Playbook"/>
    <irso:hasPlaybookID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p454</irso:hasPlaybookID>
    <irso:hasPlaybookName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Blacklist Malicious Hashes with VirusTotal &amp; VMware Carbon Black EDR</irso:hasPlaybookName>
    <irso:hasPlaybookDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This workflow automated the process of looking up an associated file hash in VirusTotal from an InsightIDR alert. InsightConnect then posts a user response prompt to the security channel in a synopsis of the incident. Based upon the details, the incident responder will either dismiss as a false positive or block the file with VMware Carbon Black EDR. </irso:hasPlaybookDescription>
