    <irso:hasPlaybookName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TIM - Process Indicators Against Organizations External IP List</irso:hasPlaybookName>
    <irso:hasPlaybookDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This playbook processes indicators to check if they exist in a Cortex XSOAR list containing the organizational External IP addresses or CIDR, and tags the indicators accordingly.</irso:hasPlaybookDescription>
