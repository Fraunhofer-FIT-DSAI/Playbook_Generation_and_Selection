  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Playbook_p1013">
    <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Playbook"/>
    <irso:hasPlaybookID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p1013</irso:hasPlaybookID>
    <irso:hasPlaybookName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AutoFocusPolling</irso:hasPlaybookName>
    <irso:hasPlaybookDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use this playbook as a sub-playbook to  query PANW Autofocus Threat intelligence system. This sub-playbook is the same as the generic polling sub-playbook besides that it provides outputs in the playbook. The reason for that is that in Autofocus its impossible to query the results of the same query more than once so the outputs have to be in the polling context.  This playbook implements polling by continuously running the command in Step \#2 until the operation completes. The remote action should have the following structure:  1. Initiate the operation. 2. Poll to check if the operation completed. 3. (optional) Get the results of the operation.</irso:hasPlaybookDescription>
    <irso:providedBy rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Vendor_XSOAR"/>
    <irso:hasStep rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Step_s13568"/>
    <irso:hasStep rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Step_s13569"/>
    <irso:hasStep rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Step_s13570"/>
    <irso:hasStep rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Step_s13572"/>
  </rdf:Description>
