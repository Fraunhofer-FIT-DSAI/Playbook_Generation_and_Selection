  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Playbook_p515">
    <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Playbook"/>
    <irso:hasPlaybookID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p515</irso:hasPlaybookID>
    <irso:hasPlaybookName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrich Hash with Threat Intelligence from Threat Crowd</irso:hasPlaybookName>
    <irso:hasPlaybookDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This workflow is meant to introduce InsightIDR users to plugins, actions, and running workflows. The workflow uses an API trigger, which accepts a single string input, to lookup a hash in Threat Crowd, a free-to-use threat intelligence service. This workflow is easy to test out for users who are new to InsightConnect and automation workflows.</irso:hasPlaybookDescription>
    <irso:providedBy rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Vendor_Rapid7"/>
    <irso:hasStep rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Step_s6116"/>
