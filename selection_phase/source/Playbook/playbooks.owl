    <irso:hasPlaybookName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quarantine Endpoint with CrowdStrike Falcon from Microsoft Teams</irso:hasPlaybookName>
    <irso:hasPlaybookDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This workflow quarantines or unquarantines endpoints with CrowdStrike Falcon via Microsoft Teams command and reports information back to the message thread.This workflow supports endpoints in the form of Device IDs, hostnames, external IP addresses or MAC addresses.</irso:hasPlaybookDescription>
    <irso:providedBy rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Vendor_Rapid7"/>
    <irso:hasStep rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Step_s7710"/>
