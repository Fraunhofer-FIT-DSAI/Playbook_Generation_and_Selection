  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Playbook_p578">
    <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Playbook"/>
    <irso:hasPlaybookID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p578</irso:hasPlaybookID>
    <irso:hasPlaybookName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Office 365 Analysis Palo Alto Wildfire</irso:hasPlaybookName>
    <irso:hasPlaybookDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This workflow is designed to automatically analyze incoming emails to determine if they are malicious. This workflow assumes a user is using their report phishing button to send an email to an administrative account with the suspicious email attached. The workflow will then analyze the attached email for any suspicious links or files. If any malicious indicators are found the email will be remediated across the organization.</irso:hasPlaybookDescription>
