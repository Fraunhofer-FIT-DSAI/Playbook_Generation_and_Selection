    <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2025/1/IncidentResponseSecurityOntology#Playbook"/>
    <irso:hasPlaybookID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p622</irso:hasPlaybookID>
    <irso:hasPlaybookName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Send Remediated Vulnerabilities Message in Microsoft Teams from InsightVM</irso:hasPlaybookName>
    <irso:hasPlaybookDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This workflow listens for InsightVM Webhook Events for newly remediated vulnerabilities and notifies a Microsoft Teams channel of remediated vulnerabilities with a CVSS risk score greater than 4. It also includes asset information to easily identify which system the vulnerabilities were remediated from.</irso:hasPlaybookDescription>
